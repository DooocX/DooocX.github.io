<%- partial('_partial/header', { name: 'showreel' }) %>

<div class="showreel">
  <%- partial('_widget/header_body', {
    message: theme.headers.showreel.message,
    icon: theme.headers.showreel.icon
  }) %>

  <div class="showreel-content" id="content">
    <% if (page.items && page.items.length) { %>
      <div class="showreel-toolbar" aria-label="作品工具栏">
        <div class="showreel-sort" role="group" aria-label="作品排序">
          <span class="showreel-sort-label">排序：</span>
          <button class="showreel-sort-btn active" type="button" data-sort="date_desc" aria-pressed="true">最新发布</button>
          <button class="showreel-sort-btn" type="button" data-sort="date_asc" aria-pressed="false">最早发布</button>
        </div>
        <div class="showreel-search" aria-label="作品搜索">
          <button class="showreel-search-toggle" type="button" aria-label="搜索作品" aria-expanded="false" aria-controls="showreel-search-panel">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M21 21l-4.35-4.35M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"/>
            </svg>
          </button>
          <div class="showreel-search-panel" id="showreel-search-panel" hidden>
            <div class="showreel-search-box">
              <input id="showreel-search-input" class="showreel-search-input" type="search" placeholder="输入标题关键词..." autocomplete="off" />
              <button class="showreel-search-clear" type="button" aria-label="清空搜索">清空</button>
            </div>
            <p class="showreel-search-meta" id="showreel-search-meta"></p>
          </div>
        </div>
      </div>
      <ul class="showreel-list">
        <% page.items.forEach(function(item) { %>
          <li class="showreel-card" data-date="<%= new Date(item.date).getTime() %>">
            <a class="showreel-card-link" href="<%- url_for(item.path) %>">
              <div class="showreel-card-cover">
                <img src="<%- item.cover %>" alt="<%= item.title %>" loading="lazy" referrerpolicy="no-referrer">
                <% if (item.duration) { %>
                  <span class="showreel-card-duration"><%= item.duration %></span>
                <% } %>
                <% if (item.video && item.video.type === 'bilibili') { %>
                  <span class="showreel-card-source" title="来自 Bilibili">
                    <img src="/image/icon-bilibili.svg" alt="bilibili">
                  </span>
                <% } %>
              </div>
              <div class="showreel-card-info">
                <h3 class="showreel-card-title"><%= item.title %></h3>
                <% if (item.description) { %>
                  <p class="showreel-card-desc"><%= item.description %></p>
                <% } %>
                <div class="showreel-card-meta">
                  <% if (item.tools && item.tools.length) { %>
                    <ul class="showreel-card-tools">
                      <% item.tools.forEach(function(t) { %>
                        <li><%= t %></li>
                      <% }) %>
                    </ul>
                  <% } %>
                  <time class="showreel-card-date">
                    <%- date(item.date, 'YYYY-MM-DD') %>
                  </time>
                </div>
              </div>
            </a>
          </li>
        <% }) %>
      </ul>
      <div class="showreel-search-empty" id="showreel-search-empty" hidden>
        <p>未找到匹配作品</p>
      </div>
    <% } else { %>
      <div class="showreel-empty">
        <p>作品正在路上，敬请期待 ☕</p>
      </div>
    <% } %>
  </div>
</div>
